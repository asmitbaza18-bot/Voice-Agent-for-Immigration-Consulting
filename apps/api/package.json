{
  "name": "@chhetry/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify API (text-first, Milestone 1). Voice session gateway comes in Milestone 2.",
  "exports": {
    ".": "./src/index.ts"
  },
