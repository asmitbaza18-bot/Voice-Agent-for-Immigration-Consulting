# Copy to .env for local development. Never commit real values.
# Production secrets live in the secret manager (CLAUDE.md section 13).
DATABASE_URL=postgresql://chhetry:chhetry@localhost:5432/chhetry_voice
# 32-byte keys, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEYS is a comma-separated list of keyId:base64key. The first entry encrypts; all entries decrypt.
FIELD_ENCRYPTION_KEYS=k1:REPLACE_ME
# Keyed hash for searchable lookups of encrypted fields (e.g. find person by A-number).
FIELD_LOOKUP_HMAC_KEY=REPLACE_ME
LOG_LEVEL=info
